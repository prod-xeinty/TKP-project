# GEMINI_API_KEY: Ключ внешнего LLM-API для анализа реплик и генерации правок ТКП
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DB_PATH: Путь к локальному файлу базы данных SQLite
DB_PATH="./data/tkp_advisor.sqlite"

# SEARCH_REGION: Регион и параметры поискового профиля для модуля сбора рыночных данных
SEARCH_REGION="РФ (B2B-сегмент)"

# STALE_THRESHOLD_DAYS: Порог устаревания записей справочника (в днях)
STALE_THRESHOLD_DAYS="90"

# APP_URL: Локальный адрес приложения
APP_URL="http://localhost:3000"
